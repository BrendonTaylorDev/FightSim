From ccd697055f1a4022a42dedf1025fdb84e40cf24f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 11:09:12 +0000
Subject: [PATCH 6/9] Fix: an action's direction is no longer cut off
 mid-sentence at 24 words (director.flavor_words, 32)

---
 director.py | 3 ++-
 rules.json  | 2 ++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/director.py b/director.py
index 3e5c07a..75c56f2 100644
--- a/director.py
+++ b/director.py
@@ -708,7 +708,8 @@ def resolve(engine, b):
     if act not in ACTIONS and act not in ("quickpin", "pin_success", "pin_escape", "land", "down", "getup", "heal"):
         raise ValueError(f"action must be one of {ACTIONS}")
     att = b.get("attacker")
-    flavor = short_phrase(b.get("flavor", ""), 24)  # keep it a label, not a paragraph (never ending on "and")
+    flavor = short_phrase(b.get("flavor", ""), int(engine.rules.get("director", {}).get("flavor_words", 32)))
+    # (keep it a label, not a paragraph, never ending on "and")
     intent = b.get("intent", "")
     was_involved = engine.get(att).name in engine.involved
     engine.get_active(att)
diff --git a/rules.json b/rules.json
index 01bad1b..bbf42f8 100644
--- a/rules.json
+++ b/rules.json
@@ -1269,6 +1269,8 @@
   "director": {
     "_comment": "initiative: once one fighter has made initiative_after attacks in a row (and an opponent still has at least initiative_min_strength % of full strength), each beat there's a chance the director is told to shift the momentum: initiative_chance at first, +initiative_step for every extra attack in the streak, up to initiative_max. Streaks can run long, just not usually. With /plan dominate, the winner's streaks shift only initiative_dominate_factor as often. initiative_after 0 turns it off.",
     "initiative_after": 3,
+    "_flavor_words_comment": "flavor_words: the author's or director's one-line direction for an action is kept to at most this many words (a label, not a paragraph); a longer one is cut there (an order cut mid-sentence reads wrong, so keep this generous).",
+    "flavor_words": 32,
     "initiative_min_strength": 35,
     "_pin_urge_comment": "How often there is an OPENING for a new pin on a fighter, rolled each beat before the director chooses (the director can only start a pin where there is one; your /commands and typed directions always can). standing: on her feet with at least weak_below % of her strength (rare, but a pin can come at any point). downed: knocked down, same strength. weak_standing / weak_downed: under weak_below % of her strength; these then climb toward max as she nears 0. helpless: asleep or frozen. When there is an opening and you just press Enter, the director is told to go for it.",
     "pin_urge": {
-- 
